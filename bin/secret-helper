#!/usr/bin/env bash
# The capability boundary. ADR-0005, spec section 9.
#
#   "Capabilities, not credentials. Secrets in age/sops, decrypted per-call by a helper the
#    agent cannot read."
#
# What "cannot read" means precisely, because it is easy to get wrong by one file mode:
#
#   she CANNOT read   /srv/friday/secrets/          root:root 0700 - the age identity, the
#                                                   sops files, the master key, every OTHER
#                                                   agent's key
#   she CAN read      /run/friday/<unit>.env        0600 friday:friday, tmpfs, one credential
#
# So an injection that reaches a tool call can use the capability the running unit already
# has. It cannot enumerate the others and it cannot walk away with the keys. That is the
# whole of what this buys, and it is worth the friction.
#
# Runs as ROOT, from systemd ExecStartPre with a '+' prefix. If you ever find yourself making
# this readable by `friday`, stop: the reason it is root-owned is the entire point.
#
#   secret-helper litellm-env <out>          the master key, for the proxy only
#   secret-helper agent-key <agent> <out>    ONE agent's virtual key
#   secret-helper env <name> <out>           a named sops env file (radicale, mail, hass)

set -euo pipefail

ROOT=${ROOT:-/srv/friday}
SECRETS="$ROOT/secrets"
AGE_KEY="$SECRETS/age.key"

die() { printf 'secret-helper: %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "must run as root. In a unit, prefix ExecStartPre with '+'."
[[ -f "$AGE_KEY" ]] || die "no age identity at $AGE_KEY"
command -v sops >/dev/null 2>&1 || die "sops not found"

# Write a file only friday can read, atomically. The umask matters: a world-readable window
# between create and chmod is a window, and this runs on every service start.
emit() {
  local out="$1" content="$2"
  local dir; dir="$(dirname "$out")"
  install -d -m 0700 -o friday -g friday "$dir"
  local tmp; tmp="$(mktemp "$dir/.sh-XXXXXX")"
  chmod 0600 "$tmp"; chown friday:friday "$tmp"
  printf '%s' "$content" > "$tmp"
  mv -f "$tmp" "$out"
}

cmd="${1:-}"; shift || true

case "$cmd" in

  litellm-env)
    out="${1:?usage: secret-helper litellm-env <out>}"
    # The ONLY consumer of the master key. Spec section 8: it exists to mint per-agent
    # virtual keys and for nothing else, and no other unit is ever configured with it.
    emit "$out" "$(SOPS_AGE_KEY_FILE="$AGE_KEY" sops --decrypt "$SECRETS/litellm.env.sops")"
    ;;

  agent-key)
    agent="${1:?usage: secret-helper agent-key <agent> <out>}"
    out="${2:?usage: secret-helper agent-key <agent> <out>}"
    [[ "$agent" =~ ^[a-z][a-z0-9_-]*$ ]] || die "bad agent name: $agent"
    [[ -f "$SECRETS/litellm-keys.yaml" ]] || die "no keys yet. Run install/05-litellm-keys.sh."

    # Extract exactly one agent's key. The decrypted blob never touches disk - it lives in a
    # variable in this process, which exits immediately after.
    key="$(SOPS_AGE_KEY_FILE="$AGE_KEY" sops --decrypt "$SECRETS/litellm-keys.yaml" \
           | awk -v a="^${agent}:$" '$0 ~ a {f=1; next} f && /^  key:/ {print $2; exit} /^[a-z]/ && f {exit}')"
    [[ -n "$key" ]] || die "no key for agent '$agent'"
    emit "$out" "$(printf 'LITELLM_API_KEY=%s\nLITELLM_BASE_URL=http://127.0.0.1:4000\n' "$key")"
    ;;

  env)
    name="${1:?usage: secret-helper env <name> <out>}"
    out="${2:?usage: secret-helper env <name> <out>}"
    [[ "$name" =~ ^[a-z][a-z0-9_-]*$ ]] || die "bad name: $name"
    src="$SECRETS/${name}.env.sops"
    [[ -f "$src" ]] || die "no such secret: $src"
    emit "$out" "$(SOPS_AGE_KEY_FILE="$AGE_KEY" sops --decrypt "$src")"
    ;;

  *)
    die "unknown command '${cmd}'. One of: litellm-env, agent-key, env"
    ;;
esac
